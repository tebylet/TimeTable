<?xml version="1.0" encoding="utf-8"?>
<!--
  Встроенный адрес сервера расписания http://80.242.59.206:3000 использует
  HTTP. Резервные адреса приложение получает от сервера автоматически. Начиная
  с Android 9 (API 28) обычный, незашифрованный HTTP-трафик по умолчанию
  заблокирован системой — без этого файла запросы к серверу (синхронизация
  расписания, проверка обновлений и их скачивание) в release-сборке будут
  тихо падать с ошибкой сети.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
